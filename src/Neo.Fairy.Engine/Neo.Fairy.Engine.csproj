<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Neo.Fairy.Engine</RootNamespace>
    <AssemblyName>Neo.Fairy.Engine</AssemblyName>
    <Version>1.1.0</Version>
    <Authors>Neo Project</Authors>
    <Description>Execution engine for Neo Fairy Framework - VM execution with runtime overrides</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.Fairy.Core\Neo.Fairy.Core.csproj" />
  </ItemGroup>

  <!-- Neo dependencies - prefer merged repo layout -->
  <ItemGroup Condition="Exists('$(NeoRoot)/src/Neo.ConsoleService/Neo.ConsoleService.csproj')">
    <ProjectReference Include="$(NeoRoot)/src/Neo.ConsoleService/Neo.ConsoleService.csproj" />
    <ProjectReference Include="$(NeoRoot)/src/Neo.Json/Neo.Json.csproj" />
    <ProjectReference Include="$(NeoRoot)/src/Plugins/RpcServer/RpcServer.csproj" />
  </ItemGroup>

  <!-- Neo dependencies - split neo_csharp layout (core + node) -->
  <ItemGroup Condition="Exists('$(NeoRoot)/core/src/Neo.Json/Neo.Json.csproj') and Exists('$(NeoRoot)/node/src/Neo.ConsoleService/Neo.ConsoleService.csproj')">
    <ProjectReference Include="$(NeoRoot)/core/src/Neo.Json/Neo.Json.csproj" />
    <ProjectReference Include="$(NeoRoot)/node/src/Neo.ConsoleService/Neo.ConsoleService.csproj" />
    <ProjectReference Include="$(NeoRoot)/node/plugins/RpcServer/RpcServer.csproj" />
  </ItemGroup>

</Project>
