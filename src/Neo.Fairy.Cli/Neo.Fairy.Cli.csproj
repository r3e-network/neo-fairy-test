<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Neo.Fairy.Cli</RootNamespace>
    <AssemblyName>fairy</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Neo Project</Authors>
    <Description>CLI tool for Neo Fairy Framework - Professional Neo N3 smart contract development</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fairy</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.Fairy.Core\Neo.Fairy.Core.csproj" />
    <ProjectReference Include="..\Neo.Fairy.Engine\Neo.Fairy.Engine.csproj" />
    <ProjectReference Include="..\Neo.Fairy.Testing\Neo.Fairy.Testing.csproj" />
  </ItemGroup>

</Project>
